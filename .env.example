# Server-only secrets — never expose to the browser
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_AGENT_ID=
GROQ_API_KEY=
# More room: a free Groq key allows 200,000 tokens a day per model. Comma-separated keys share the load and cover for each other.
# GROQ_API_KEYS=key1,key2
GROQ_MODEL=openai/gpt-oss-120b
SUPABASE_SERVICE_ROLE_KEY=

# Safe public environment variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_MODE=true
