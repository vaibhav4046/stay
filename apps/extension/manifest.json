{
  "manifest_version": 3,
  "name": "Stay: park a thought",
  "version": "1.0.0",
  "description": "Park a stray thought from any page without losing your place, see your next Stay check-in on the toolbar, and open Stay to talk. Local only: no network, no account.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Stay",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["contextMenus", "storage", "alarms"],
  "host_permissions": ["https://stay-two-swart.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://stay-two-swart.vercel.app/*"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-voice": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open Stay and start talking"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the Stay popup (park a thought)"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
