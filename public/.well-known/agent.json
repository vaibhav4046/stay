{
  "$schema": "https://a2a-protocol.org/schemas/v1.0/agent-card.json",
  "protocol_version": "1.0",
  "agent_id": "urn:stay:companion:voice-initiator-v1",
  "name": "Stay Voice Initiation Companion",
  "version": "1.0.0",
  "description": "Voice-first ADHD task initiation and cognitive load companion, engineered for continuous voice conversation, sub-second latency, and gentle executive scaffolding.",
  "organization": {
    "name": "Stay Cognitive Engineering",
    "url": "https://stay-two-swart.vercel.app",
    "contact": "support@stay.app"
  },
  "endpoints": {
    "rpc": "https://stay-two-swart.vercel.app/api/a2a/rpc",
    "events": "https://stay-two-swart.vercel.app/api/a2a/events",
    "mcp_bridge": "https://stay-two-swart.vercel.app/api/mcp",
    "health": "https://stay-two-swart.vercel.app/api/keys/check"
  },
  "capabilities": {
    "delegation": {
      "supports_task_delegation": true,
      "max_concurrent_subtasks": 4,
      "delegation_timeout_seconds": 60
    },
    "audio": {
      "streaming_in": true,
      "streaming_out": true,
      "input_format": "audio/pcm;rate=24000;bits=16;encoding=little-endian",
      "output_format": "audio/pcm;rate=24000;bits=16;encoding=little-endian",
      "provider": "AssemblyAI Universal-3-6-Pro"
    },
    "skills": [
      {
        "id": "task_shrinking",
        "name": "Task Shrinking",
        "description": "Reduces overwhelming goals into a single non-intimidating <= 2 minute micro-action."
      },
      {
        "id": "sensory_grounding",
        "name": "Sensory Grounding",
        "description": "5-4-3-2-1 somatic grounding sequence for cognitive panic or ADHD freeze."
      },
      {
        "id": "brain_dump",
        "name": "Spoken Brain Dump",
        "description": "Transcribes unfiltered stream-of-consciousness speech and categorizes actionable tasks."
      },
      {
        "id": "body_doubling",
        "name": "Continuous Body Doubling",
        "description": "Quiet presence with periodic gentle check-ins while user works on their primary step."
      }
    ],
    "memory": {
      "cross_session_stateful": true,
      "retention_policy_days": 45,
      "encryption": "AES-256-GCM / Client-Scoped"
    }
  },
  "security": {
    "auth_type": "OAuth2-mTLS",
    "token_endpoint": "https://stay-two-swart.vercel.app/api/a2a/token",
    "jwks_uri": "https://stay-two-swart.vercel.app/api/a2a/jwks",
    "required_scopes": ["stay:agent:delegate", "stay:agent:observe"]
  },
  "telemetry": {
    "standard": "OpenTelemetry / OpenInference v0.1",
    "export_formats": ["OTLP-JSON", "Langfuse", "Braintrust", "Arize Phoenix"]
  },
  "signature": {
    "algorithm": "Ed25519",
    "public_key": "MCowBQYDK2VwAyEA4a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d",
    "signature_value": "3a8f9c2d1e0b5a4f7c8d9e0b1a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c"
  }
}
